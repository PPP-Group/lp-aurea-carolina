{
    auto_https off
}

:{$PORT:80} {
    root * dist
    encode gzip zstd

    # Headers de seguranca
    header {
        X-Content-Type-Options nosniff
        -Server
    }

    # Cache imutavel para assets versionados com hash (JS, CSS)
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"

    # Cache moderado para fontes, imagens e favicon
    @media path *.woff2 *.webp *.svg *.png *.jpg *.jpeg *.ico
    header @media Cache-Control "public, max-age=604800"

    # Sem cache para index.html
    @html path / /index.html
    header @html Cache-Control "no-cache"

    # Roteamento SPA: qualquer rota nao estatica cai no index.html
    try_files {path} /index.html
    file_server
}
